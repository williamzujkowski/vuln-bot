---
layout: layouts/base
title: Vulnerability Intelligence Dashboard - Vuln-Bot
---

<div class="dashboard-container" x-data="vulnDashboard()" x-cloak>
  <!-- Modern Dashboard Header -->
  <header class="dashboard-header">
    <div class="header-content">
      <div class="brand">
        <div class="brand-logo">VB</div>
        <div>
          <h1 class="brand-title">Vuln-Bot Intelligence</h1>
          <p class="brand-subtitle">High-Risk CVE Monitoring Platform</p>
        </div>
      </div>
      
      <div class="header-actions">
        <button @click="showDataInsights = true" class="btn-header">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
          Insights
        </button>
        
        <button @click="exportResults()" class="btn-header">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Export
        </button>
        
        <button @click="showSettings = true" class="btn-header">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 1v6m0 6v6m11-6h-6m-6 0H1"></path>
          </svg>
          Settings
        </button>
      </div>
    </div>
  </header>

  <!-- Main Dashboard Content -->
  <main class="dashboard-main">
    <!-- Loading State -->
    <div x-show="loading" class="loading-container">
      <div class="loading-spinner"></div>
      <p class="loading-text">Loading vulnerability data...</p>
    </div>

    <!-- Error State -->
    <div x-show="error && !loading" class="error-container" role="alert">
      <svg class="icon icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <h2>Unable to Load Data</h2>
      <p x-text="error"></p>
      <button @click="loadVulnerabilities()" class="btn-primary">Try Again</button>
    </div>

    <!-- Dashboard Content -->
    <div x-show="!loading && !error" class="fade-in">
      <!-- Key Metrics Cards -->
      <section class="stats-grid" aria-label="Key vulnerability metrics">
        <div class="stat-card">
          <div class="stat-value" x-text="vulnerabilities.length"></div>
          <div class="stat-label">Total Vulnerabilities</div>
          <div class="stat-change positive">
            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            </svg>
            <span>+12% from last week</span>
          </div>
        </div>
        
        <div class="stat-card">
          <div class="stat-value" x-text="vulnerabilities.filter(v => v.severity === 'CRITICAL').length"></div>
          <div class="stat-label">Critical Severity</div>
          <div class="stat-change negative">
            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
            </svg>
            <span>+5 new today</span>
          </div>
        </div>
        
        <div class="stat-card">
          <div class="stat-value" x-text="vulnerabilities.filter(v => v.epssPercentile >= 90).length"></div>
          <div class="stat-label">High EPSS (≥90%)</div>
          <div class="stat-change positive">
            <span>Active exploitation likely</span>
          </div>
        </div>
        
        <div class="stat-card">
          <div class="stat-value" x-text="Math.round(vulnerabilities.reduce((acc, v) => acc + (v.riskScore || 0), 0) / Math.max(vulnerabilities.length, 1))"></div>
          <div class="stat-label">Average Risk Score</div>
          <div class="stat-change">
            <span>Out of 100</span>
          </div>
        </div>
      </section>

      <!-- Quick Actions Bar -->
      <section class="quick-actions" aria-label="Quick actions">
        <button @click="applyQuickFilter('critical')" class="quick-filter-btn">
          <span class="severity-badge severity-critical">Critical Only</span>
        </button>
        <button @click="applyQuickFilter('today')" class="quick-filter-btn">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Today's CVEs
        </button>
        <button @click="applyQuickFilter('kev')" class="quick-filter-btn">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          KEV Listed
        </button>
        <button @click="applyQuickFilter('network')" class="quick-filter-btn">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M16.24 7.76a6 6 0 010 8.49m-8.48-.01a6 6 0 010-8.49m11.31-2.82a10 10 0 010 14.14m-14.14 0a10 10 0 010-14.14"></path>
          </svg>
          Network Vector
        </button>
      </section>

      <!-- Advanced Search and Filters -->
      <section class="filter-section" aria-label="Search and filters">
        <div class="filter-header">
          <h2 class="filter-title">
            <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            Search & Filter
          </h2>
          <button @click="filtersExpanded = !filtersExpanded" class="btn-toggle">
            <span x-text="filtersExpanded ? 'Collapse' : 'Expand'"></span>
          </button>
        </div>
        
        <div x-show="filtersExpanded" class="filter-content">
          <!-- Search Bar -->
          <div class="search-container">
            <input 
              type="text" 
              x-model="searchQuery"
              @input.debounce.300ms="applyFilters()"
              placeholder="Search by CVE ID, vendor, product, or keyword..."
              class="search-input"
              aria-label="Search vulnerabilities"
            >
            <div class="search-suggestions" x-show="searchSuggestions.length > 0">
              <template x-for="suggestion in searchSuggestions" :key="suggestion">
                <button @click="searchQuery = suggestion; applyFilters()" class="suggestion-item" x-text="suggestion"></button>
              </template>
            </div>
          </div>
          
          <!-- Filter Grid -->
          <div class="filter-grid">
            <div class="form-group">
              <label class="form-label">Severity Level</label>
              <select x-model="filters.severity" @change="applyFilters()" class="form-input">
                <option value="">All Severities</option>
                <option value="CRITICAL">Critical</option>
                <option value="HIGH">High</option>
                <option value="MEDIUM">Medium</option>
                <option value="LOW">Low</option>
              </select>
            </div>
            
            <div class="form-group">
              <label class="form-label">CVSS Score Range</label>
              <div class="range-input-group">
                <input type="number" x-model="filters.cvssMin" @change="applyFilters()" min="0" max="10" step="0.1" class="form-input range-input">
                <span class="range-separator">to</span>
                <input type="number" x-model="filters.cvssMax" @change="applyFilters()" min="0" max="10" step="0.1" class="form-input range-input">
              </div>
            </div>
            
            <div class="form-group">
              <label class="form-label">EPSS Score Range</label>
              <div class="range-input-group">
                <input type="number" x-model="filters.epssMin" @change="applyFilters()" min="0" max="100" step="1" class="form-input range-input">
                <span class="range-separator">to</span>
                <input type="number" x-model="filters.epssMax" @change="applyFilters()" min="0" max="100" step="1" class="form-input range-input">
              </div>
            </div>
            
            <div class="form-group">
              <label class="form-label">Date Range</label>
              <input type="date" x-model="filters.publishedDateFrom" @change="applyFilters()" class="form-input">
            </div>
          </div>
          
          <!-- Active Filters Display -->
          <div x-show="hasActiveFilters()" class="active-filters">
            <span class="active-filters-label">Active filters:</span>
            <template x-for="filter in getActiveFilters()" :key="filter.key">
              <span class="filter-tag">
                <span x-text="filter.label"></span>
                <button @click="removeFilter(filter.key)" class="filter-remove" aria-label="Remove filter">×</button>
              </span>
            </template>
            <button @click="resetFilters()" class="btn-link">Clear all</button>
          </div>
        </div>
      </section>

      <!-- Data Visualization Charts -->
      <section class="charts-grid" aria-label="Data visualizations">
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Severity Distribution</h3>
            <button class="btn-icon" aria-label="Chart options">⋮</button>
          </div>
          <canvas id="severityChart" width="400" height="200"></canvas>
        </div>
        
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">30-Day Trend</h3>
            <button class="btn-icon" aria-label="Chart options">⋮</button>
          </div>
          <canvas id="trendChart" width="400" height="200"></canvas>
        </div>
        
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Top Affected Vendors</h3>
            <button class="btn-icon" aria-label="Chart options">⋮</button>
          </div>
          <canvas id="vendorChart" width="400" height="200"></canvas>
        </div>
        
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">EPSS Score Distribution</h3>
            <button class="btn-icon" aria-label="Chart options">⋮</button>
          </div>
          <canvas id="epssChart" width="400" height="200"></canvas>
        </div>
      </section>

      <!-- Vulnerability Data Table -->
      <section class="table-container" aria-label="Vulnerability data">
        <div class="table-header">
          <h2 class="table-title">Vulnerability Details</h2>
          <div class="table-actions">
            <span class="results-count">
              <span x-text="filteredVulns.length"></span> results
            </span>
            <select x-model="pageSize" @change="updatePagination()" class="page-size-select">
              <option value="25">25 per page</option>
              <option value="50">50 per page</option>
              <option value="100">100 per page</option>
            </select>
          </div>
        </div>
        
        <div class="table-wrapper">
          <table class="data-table" id="vulnerability-table">
            <thead>
              <tr>
                <th @click="sort('cveId')" class="sortable">
                  CVE ID
                  <span class="sort-indicator" x-show="sortField === 'cveId'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th>Description</th>
                <th @click="sort('severity')" class="sortable">
                  Severity
                  <span class="sort-indicator" x-show="sortField === 'severity'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th @click="sort('cvssScore')" class="sortable">
                  CVSS
                  <span class="sort-indicator" x-show="sortField === 'cvssScore'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th @click="sort('epssPercentile')" class="sortable">
                  EPSS
                  <span class="sort-indicator" x-show="sortField === 'epssPercentile'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th @click="sort('riskScore')" class="sortable">
                  Risk
                  <span class="sort-indicator" x-show="sortField === 'riskScore'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th>Product</th>
                <th @click="sort('publishedDate')" class="sortable">
                  Published
                  <span class="sort-indicator" x-show="sortField === 'publishedDate'">
                    <span x-show="sortDirection === 'asc'">↑</span>
                    <span x-show="sortDirection === 'desc'">↓</span>
                  </span>
                </th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="vuln in paginatedVulns" :key="vuln.cveId">
                <tr class="table-row">
                  <td>
                    <button @click="openCveModal(vuln.cveId)" class="cve-button" x-text="vuln.cveId"></button>
                  </td>
                  <td class="title-cell">
                    <span x-text="vuln.title.substring(0, 80) + (vuln.title.length > 80 ? '...' : '')" :title="vuln.title"></span>
                  </td>
                  <td>
                    <span class="severity-badge" :class="'severity-' + vuln.severity.toLowerCase()" x-text="vuln.severity"></span>
                  </td>
                  <td>
                    <span class="score-value" x-text="vuln.cvssScore || 'N/A'"></span>
                  </td>
                  <td>
                    <span class="epss-value" x-text="vuln.epssPercentile + '%'"></span>
                  </td>
                  <td>
                    <span x-text="vuln.riskScore || 0"></span>
                  </td>
                  <td>
                    <span x-show="vuln.products && vuln.products.length > 0" x-text="vuln.products[0]"></span>
                    <span x-show="(!vuln.products || vuln.products.length === 0) && vuln.vendors && vuln.vendors.length > 0" x-text="vuln.vendors[0]"></span>
                    <span x-show="(!vuln.products || vuln.products.length === 0) && (!vuln.vendors || vuln.vendors.length === 0)">Unknown</span>
                  </td>
                  <td>
                    <time :datetime="vuln.publishedDate" x-text="formatDate(vuln.publishedDate)"></time>
                  </td>
                  <td>
                    <div class="action-buttons">
                      <button @click="openCveModal(vuln.cveId)" class="btn-icon" aria-label="View details">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                      </button>
                      <button @click="copyToClipboard(vuln.cveId)" class="btn-icon" aria-label="Copy CVE ID">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="table-pagination">
          <button @click="previousPage()" :disabled="currentPage === 1" class="pagination-btn">
            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Previous
          </button>
          
          <div class="pagination-info">
            <span>Page</span>
            <input type="number" x-model="currentPage" @change="updatePagination()" min="1" :max="totalPages" class="page-input">
            <span>of <span x-text="totalPages"></span></span>
          </div>
          
          <button @click="nextPage()" :disabled="currentPage === totalPages" class="pagination-btn">
            Next
            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </section>
    </div>
  </main>
</div>

<!-- Include the CVE modal component -->
{% include "components/cve-modal.njk" %}

<!-- Add the redesigned CSS -->
<link rel="stylesheet" href="{{ '/assets/css/dashboard-redesign.css' | url }}">

<!-- Chart.js for data visualization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<!-- Initialize enhanced dashboard -->
<script src="{{ '/assets/js/dashboard-enhanced.js' | url }}"></script>