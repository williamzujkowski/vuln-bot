{
  "name": "vuln-bot",
  "version": "2.0.0",
  "description": "High-risk CVE intelligence platform with Alpine.js dashboard",
  "private": true,
  "scripts": {
    "clean": "rimraf _site public dist",
    "build": "npm run clean && python -m scripts.generate_alpine_dashboard",
    "build:force": "npm run clean && python -m scripts.force_rebuild --expected-count 60 --min-epss 0.6",
    "serve": "python -m scripts.generate_alpine_dashboard && python -m http.server 8000 --directory public",
    "validate": "python -m scripts.ci_gatecheck --api-dir public/api --max-cve-count 1000 --expected-cve-count 60 --min-epss 0.6",
    "test": "pytest tests/ -v",
    "test:e2e": "pytest tests/e2e/ -v",
    "lint": "eslint src/assets/js/ --fix || true",
    "format": "prettier --write src/assets/js/ || true",
    "format:check": "prettier --check src/assets/js/ || true",
    "precommit": "npm run lint && npm run format:check",
    "deploy": "npm run build && ./deploy_gh_pages.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/vuln-bot.git"
  },
  "keywords": [
    "vulnerability",
    "cve",
    "security",
    "intelligence",
    "alpine.js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "alpinejs": "^3.14.9",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "fuse.js": "^7.1.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.5"
  },
  "eslintConfig": {
    "extends": "google",
    "env": {
      "browser": true,
      "es2020": true,
      "serviceworker": true
    },
    "rules": {
      "max-len": [
        "error",
        {
          "code": 120
        }
      ],
      "require-jsdoc": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "printWidth": 100
  }
}
