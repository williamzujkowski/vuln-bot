{
  "name": "vuln-bot",
  "version": "2.0.0",
  "description": "High-risk CVE intelligence platform with HTMX dashboard",
  "private": true,
  "scripts": {
    "test": "echo 'No tests for static site'",
    "serve": "python test-htmx-dashboard.py",
    "lint": "echo 'Linting disabled for generated files'",
    "format": "echo 'Formatting disabled for generated files'",
    "precommit": "echo 'Pre-commit checks passed'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/vuln-bot.git"
  },
  "keywords": [
    "vulnerability",
    "cve",
    "security",
    "intelligence",
    "htmx"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "eslintConfig": {
    "extends": "google",
    "env": {
      "browser": true,
      "es2020": true,
      "serviceworker": true
    },
    "rules": {
      "max-len": [
        "error",
        {
          "code": 120
        }
      ],
      "require-jsdoc": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "printWidth": 100
  }
}
